{
  "name": "buppo-game",
  "version": "0.1.1",
  "description": "BUPPO desktop build",
  "author": "Victor Franco",
  "license": "UNLICENSED",
  "type": "module",
  "main": "desktop/main.cjs",
  "private": true,
  "scripts": {
    "desktop": "electron .",
    "test": "node --test tests/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project buppo-game-rules-test \"node --test tests/firestore.rules.emulator.js\"",
    "check:syntax": "node scripts/check-syntax.mjs",
    "validate:security": "node scripts/validate-security.mjs",
    "validate:version": "node scripts/validate-version.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "check": "npm run check:syntax && npm run validate:version && npm run validate:security && npm run validate:assets && npm test",
    "dist:win": "electron-builder --win nsis portable",
    "dist:win:installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.buppo.game",
    "productName": "BUPPO",
    "files": [
      "index.html",
      "manifest.json",
      "desktop/**/*",
      "assets/**/*",
      "!assets/personagem_*.png",
      "!assets/img/*_chroma.png",
      "!assets/img/*_source.png",
      "!assets/img/janela_diario_batalha.png",
      "css/**/*",
      "js/**/*"
    ],
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/img/pwa-icon-512.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "BUPPO-${version}-Windows.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BUPPO-${version}-Setup.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "VictorFrancodaCosta",
        "repo": "buppo-game",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "firebase": "^12.16.0",
    "firebase-tools": "^15.23.0"
  }
}
